# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Ngrok Configuration
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
BACKEND_ngrok_LINK=your-ngrok-domain.ngrok-free.app

# Retell Configuration
RETELL_API_KEY=your_retell_api_key_here
WORKFLOW_RETELL_AGENT_ID=your_workflow_agent_id
CHECKIN_RETELL_AGENT_ID=your_checkin_agent_id
INBOUND_CALL_AGENT_ID=your_inbound_call_agent_id
RETELL_FROM_NUMBER=+1234567890

# Database Configuration
DATABASE_URL=sqlite:///./data/transit.db

# Application Configuration
PYTHONPATH=/app
ENVIRONMENT=production

# Logging Configuration
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=*

# API Rate Limiting
API_RATE_LIMIT=100

# Email Configuration
FEEDBACK_SENDER_EMAIL=your_sender_email@example.com
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FEEDBACK_RECIPIENT_EMAIL=recipient@example.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
FEEDBACK_RECIPIENT_PHONES=+1234567890

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=feedback-images

# Authentication
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash
SECRET_KEY=your_secret_key_here

