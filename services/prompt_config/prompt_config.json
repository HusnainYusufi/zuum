{
  "FORM_CONFIG": {
    "at_pickup": {
      "title": "At Pickup (Pre-arrival)",
      "fields": {
        "load_id": {
          "label": "Load # / Customer ref #",
          "type": "text",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "carrier_company": {
          "label": "Carrier company",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "pickup_address": {
          "label": "Pickup address + appointment or FCFS window",
          "type": "text",
          "required": true
        },
        "appointment_time": {
          "label": "Appointment time/window",
          "type": "text",
          "required": true
        },
        "driver_type": {
          "label": "Driver type",
          "type": "select",
          "options": [
            "Local",
            "OTR"
          ],
          "required": true
        },
        "load_type": {
          "label": "Load type",
          "type": "select",
          "options": [
            "Live load",
            "Drop trailer"
          ],
          "required": true
        },
        "tractor_number": {
          "label": "Tractor #",
          "type": "text",
          "required": false
        },
        "trailer_number": {
          "label": "Trailer #",
          "type": "text",
          "required": false
        },
        "required_equipment": {
          "label": "Required equipment (van/reefer/flatbed, temp, straps, etc.)",
          "type": "text",
          "required": false
        },
        "preferred_comms": {
          "label": "Preferred comms",
          "type": "select",
          "options": [
            "Call",
            "Text"
          ],
          "required": false
        },
        "tracking_on": {
          "label": "Current tracking on?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        }
      },
      "voice_questions": [
        "Hi, this is Zuum calling on load ### - am I speaking with [driver name] from [carrier company]?",
        "Have you checked in at the shipper yet? If not, what's your ETA to [pickup address]?",
        "If still getting offloaded from previous load, ask what city/state and how long until you'll be empty to proceed to the shipper",
        "Please confirm your tractor number, trailer number, and that you have the right equipment for this load",
        "I've sent the Zuum tracking link - can you open it so tracking starts?",
        "Have you already gotten a door number or are you still waiting for one?",
        "If they have a door number, ask what door number was assigned"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Driver_name_confirmed": {
            "type": "string",
            "description": "The confirmed name of the driver"
          },
          "Carrier_company_confirmed": {
            "type": "string",
            "description": "The confirmed carrier company name"
          },
          "Is_assigned_driver": {
            "type": "boolean",
            "description": "Whether the person on the call is the driver assigned to the load"
          },
          "Checked_in_at_shipper": {
            "type": "boolean",
            "description": "Whether the driver has already checked in at the shipper"
          },
          "ETA_to_shipper": {
            "type": "string",
            "description": "Estimated time of arrival to the shipper, or 'checked in' if already there"
          },
          "Still_getting_offloaded": {
            "type": "boolean",
            "description": "Whether the driver is still getting offloaded from previous load"
          },
          "Offloading_location": {
            "type": "string",
            "description": "City and state where driver is getting offloaded (if applicable)"
          },
          "Time_until_empty": {
            "type": "string",
            "description": "How long until driver will be empty from current offload (if applicable)"
          },
          "Confirmed_equipment": {
            "type": "boolean",
            "description": "Whether the driver confirmed they have the correct tractor, trailer, and required equipment"
          },
          "Tracking_started": {
            "type": "boolean",
            "description": "Whether the driver confirmed they opened the tracking link and tracking has started"
          },
          "Door_number": {
            "type": "string",
            "description": "The door number assigned to the driver, or 'waiting' if not yet assigned"
          },
          "Will_be_late": {
            "type": "boolean",
            "description": "Based on ETA vs appointment time, whether driver will be late"
          }
        },
        "required": [
          "Driver_name_confirmed",
          "Carrier_company_confirmed",
          "Is_assigned_driver",
          "Checked_in_at_shipper",
          "ETA_to_shipper",
          "Still_getting_offloaded",
          "Confirmed_equipment",
          "Tracking_started",
          "Door_number",
          "Will_be_late"
        ]
      }
    },
    "pickup_complete": {
      "title": "Pickup Complete",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "carrier_company": {
          "label": "Carrier company",
          "type": "text",
          "required": true
        },
        "actual_pickup_time": {
          "label": "Actual pickup time stamp",
          "type": "datetime-local",
          "required": true
        },
        "bol_verified": {
          "label": "BOL / PO verified?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": true
        },
        "commodity_description": {
          "label": "Commodity description",
          "type": "text",
          "required": false
        },
        "next_stop_location": {
          "label": "Next stop city/state",
          "type": "text",
          "required": false
        },
        "scheduled_eta": {
          "label": "Scheduled ETA",
          "type": "datetime-local",
          "required": false
        },
        "accessorials_needed": {
          "label": "Accessorials needed so far? (lumper, temp check, straps)",
          "type": "text",
          "required": false
        }
      },
      "voice_questions": [
        "Hi [driver name] with [carrier company], this is Zuum calling about load ###",
        "Have you been loaded and left the dock?",
        "If they have left the dock, ask what time did you pull out?",
        "Does the PO or BOL on your paperwork match the rate confirmation? If not, please stay at the shipper - do not leave until this is corrected and you get Zuum's approval",
        "Are you the local/OTR driver who will be delivering this load, or will another driver take over?",
        "Where are you heading next - please confirm the delivery location",
        "What is your estimated time of arrival to that destination?",
        "Is there anything else you need assistance with regarding this load?"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Loaded_and_left_dock": {
            "type": "boolean",
            "description": "Whether the driver has been loaded and left the dock"
          },
          "Departure_time": {
            "type": "string",
            "description": "Time the driver pulled out from the shipper, as stated by the driver"
          },
          "PO_BOL_matches_rate_con": {
            "type": "boolean",
            "description": "Whether the PO or BOL on the paperwork matches the rate confirmation"
          },
          "BOL_issue_resolved": {
            "type": "boolean",
            "description": "If BOL doesn't match, whether the driver will stay to resolve the issue"
          },
          "Driver_will_deliver": {
            "type": "boolean",
            "description": "Whether this driver will deliver the load or hand off to another driver"
          },
          "Next_destination_confirmed": {
            "type": "string",
            "description": "The confirmed delivery location where driver is headed"
          },
          "ETA_to_destination": {
            "type": "string",
            "description": "Driver's estimated time of arrival to the destination"
          },
          "Shipper_issues_reported": {
            "type": "boolean",
            "description": "Whether the driver reported any problems at the shipper"
          },
          "Additional_assistance_needed": {
            "type": "boolean",
            "description": "Whether the driver needs any additional assistance"
          }
        },
        "required": [
          "Loaded_and_left_dock",
          "Departure_time",
          "PO_BOL_matches_rate_con",
          "Driver_will_deliver",
          "Next_destination_confirmed",
          "ETA_to_destination",
          "Shipper_issues_reported",
          "Additional_assistance_needed"
        ]
      }
    },
    "in_transit": {
      "title": "In Transit",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "current_location": {
          "label": "Current GPS city/state",
          "type": "text",
          "required": false
        },
        "remaining_miles": {
          "label": "Remaining miles",
          "type": "number",
          "required": false
        },
        "delay_reason": {
          "label": "Known delay reason",
          "type": "select",
          "options": [
            "None",
            "Weather",
            "Traffic",
            "HOS",
            "Breakdown"
          ],
          "required": false,
          "default": "None"
        }
      },
      "voice_questions": [
        "Tell the driver we are calling since we dont see them tracking or stopped tracking for some time and ask what city and state they are in.",
        "What's your updated ETA to the receiver?",
        "Do you foresee anything that could make you late—weather, HOS, equipment?",
        "Tell the driver to please turn on tracking so we don't have to keep calling for updates"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Risk_of_delay": {
            "type": "boolean",
            "description": "Whether the driver foresees any risk of delay (e.g., weather, HOS, equipment issues)"
          },
          "Delay_reason": {
            "type": "string",
            "description": "Optional details about potential delay if risk is present"
          },
          "Current_location_manual": {
            "type": "string",
            "description": "Driver's current location (city and state), manually confirmed if tracking is not available"
          },
          "Updated_ETA_to_receiver": {
            "type": "string",
            "description": "Driver's updated estimated time of arrival to the receiver"
          },
          "Tracking_restarted": {
            "type": "boolean",
            "description": "Whether the driver reopened the tracking app during the call"
          }
        },
        "required": [
          "Risk_of_delay",
          "Delay_reason",
          "Current_location_manual",
          "Updated_ETA_to_receiver",
          "Tracking_restarted"
        ]
      }
    },
    "at_drop": {
      "title": "At Drop (On site, unloading)",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "receiver_name": {
          "label": "Receiver name",
          "type": "text",
          "required": false
        },
        "receiver_address": {
          "label": "Receiver address",
          "type": "text",
          "required": false
        },
        "delivery_type": {
          "label": "Delivery type",
          "type": "select",
          "options": [
            "Live unload",
            "Drop trailer"
          ],
          "required": true
        },
        "arrival_time": {
          "label": "Arrival time stamp",
          "type": "datetime-local",
          "required": true
        },
        "dock_number": {
          "label": "Dock #",
          "type": "text",
          "required": false
        },
        "lumper_needed": {
          "label": "Lumper needed?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "lumper_amount": {
          "label": "Lumper amount",
          "type": "number",
          "required": false
        },
        "payment_method": {
          "label": "Payment method",
          "type": "text",
          "required": false
        },
        "osd_observed": {
          "label": "OS&D observed so far?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        }
      },
      "voice_questions": [
        "I'm calling to check on your delivery at [receiver address] - have you arrived and checked in?",
        "What dock number did they assign you?",
        "Has unloading started, and how long did they quote you for completion?",
        "Only ask if delivery type is live unload and lumper field is not 'N': Do you need a lumper code?",
        "If they need lumper code, ask how much and what payment type do they accept?"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Arrived_at_receiver": {
            "type": "boolean",
            "description": "Whether the driver has arrived at the receiver address"
          },
          "Checked_in": {
            "type": "boolean",
            "description": "Whether the driver has checked in at the receiver"
          },
          "Dock_number": {
            "type": "string",
            "description": "The dock number assigned to the driver"
          },
          "Unloading_started": {
            "type": "boolean",
            "description": "Whether unloading has started"
          },
          "Unloading_duration_estimate": {
            "type": "string",
            "description": "Estimated time to complete unloading as quoted to the driver"
          },
          "Lumper_code_needed": {
            "type": "boolean",
            "description": "Whether the driver needs a lumper code (only applicable for live unload)"
          },
          "Lumper_amount": {
            "type": "string",
            "description": "Amount for lumper service if needed"
          },
          "Lumper_payment_type": {
            "type": "string",
            "description": "Payment type accepted for lumper service if needed"
          }
        },
        "required": [
          "Arrived_at_receiver",
          "Checked_in",
          "Dock_number",
          "Unloading_started",
          "Unloading_duration_estimate"
        ]
      }
    },
    "delivered": {
      "title": "Delivered",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "empty_time": {
          "label": "Time empty / out-gate time",
          "type": "datetime-local",
          "required": true
        },
        "pod_uploaded": {
          "label": "POD uploaded?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "lumper_receipt": {
          "label": "Lumper receipt / scale ticket collected?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "final_osd": {
          "label": "Final OS&D?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "osd_notes": {
          "label": "OS&D notes",
          "type": "textarea",
          "required": false
        }
      },
      "voice_questions": [
        "What time were you released from the dock?",
        "Ask for any overages, shortages or damages noted by the warehouse ?",
        "have you uploaded the signed POD, sent it to your dispatcher or can you text a photo now",
        "Any lumper receipts or scale tickets we still need?",
        "Ask the trucker if he needs any further assistance."
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "OSD_notes": {
            "type": "string",
            "description": "Driver's stated overages, shortages or damages noted by the warehouse. If no OSD, then 'None'."
          },
          "Dock_release_time": {
            "type": "string",
            "description": "The time the driver was released from the dock (e.g., '15:45' or '2025-06-06T15:45:00')"
          },
          "POD_uploaded": {
            "type": "boolean",
            "description": "Whether the signed POD has been uploaded to the Zuum app"
          },
          "POD_texted": {
            "type": "boolean",
            "description": "Whether the driver texted a photo of the signed POD (if not uploaded via app)"
          }
        },
        "required": [
          "OSD_notes",
          "Dock_release_time",
          "POD_uploaded"
        ]
      }
    },
    "request_pod": {
      "title": "Request POD - follow-up when POD still missing",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "delivery_date": {
          "label": "Delivery date/time",
          "type": "datetime-local",
          "required": true
        },
        "upload_method": {
          "label": "Preferred upload method",
          "type": "select",
          "options": [
            "App",
            "MMS",
            "Email"
          ],
          "required": false
        },
        "reminder_attempt": {
          "label": "Reminder attempt #",
          "type": "select",
          "options": [
            "1",
            "2",
            "3"
          ],
          "required": false,
          "default": "1"
        }
      },
      "voice_questions": [
        "Ask the trucker have they uploaded the signed POD, sent it to your dispatcher or can you text a photo now since our records show we are still missing this."
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "POD_followup_received": {
            "type": "boolean",
            "description": "Whether the POD was successfully received during the follow-up call (via app upload or photo text)"
          }
        },
        "required": [
          "POD_followup_received"
        ]
      }
    },
    "default": {
      "title": "Default Load Information",
      "fields": {
        "load_id": {
          "label": "Load ID",
          "type": "text",
          "required": true
        },
        "carrier_name": {
          "label": "Carrier Name",
          "type": "text",
          "required": true
        },
        "purpose": {
          "label": "Purpose",
          "type": "text",
          "required": true
        },
        "contact_name": {
          "label": "Contact Name",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Contact Phone",
          "type": "tel",
          "required": true
        },
        "scheduled_pickup_time": {
          "label": "Scheduled Pickup Time",
          "type": "datetime-local",
          "required": true
        },
        "scheduled_delivery_time": {
          "label": "Scheduled Delivery Time",
          "type": "datetime-local",
          "required": true
        },
        "origin_address": {
          "label": "Origin Address",
          "type": "text",
          "required": true
        },
        "destination_address": {
          "label": "Destination Address",
          "type": "text",
          "required": true
        },
        "last_known_status": {
          "label": "Last Known Status",
          "type": "text",
          "required": true
        },
        "last_check_call_time": {
          "label": "Last Check Call Time",
          "type": "datetime-local",
          "required": false
        },
        "notes": {
          "label": "Notes",
          "type": "textarea",
          "required": false
        }
      },
      "voice_questions": [],
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  "FORM_TYPE_MAPPING": {
    "default": 0,
    "at_pickup": 1,
    "pickup_complete": 2,
    "in_transit": 3,
    "at_drop": 4,
    "delivered": 5,
    "request_pod": 6
  }
}