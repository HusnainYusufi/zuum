{
  "FORM_CONFIG": {
    "at_pickup": {
      "title": "At Pickup (Pre-arrival)",
      "fields": {
        "load_id": {
          "label": "Load # / Customer ref #",
          "type": "text",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "pickup_address": {
          "label": "Pickup address + appointment or FCFS window",
          "type": "text",
          "required": true
        },
        "driver_type": {
          "label": "Driver type",
          "type": "select",
          "options": [
            "Local",
            "OTR"
          ],
          "required": true
        },
        "tractor_number": {
          "label": "Tractor #",
          "type": "text",
          "required": false
        },
        "trailer_number": {
          "label": "Trailer #",
          "type": "text",
          "required": false
        },
        "required_equipment": {
          "label": "Required equipment (van/reefer/flatbed, temp, straps, etc.)",
          "type": "text",
          "required": false
        },
        "preferred_comms": {
          "label": "Preferred comms",
          "type": "select",
          "options": [
            "Call",
            "Text"
          ],
          "required": false
        },
        "tracking_on": {
          "label": "Current tracking on?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        }
      },
      "voice_questions": [
        "I'm calling on Zuum load ###—are you the driver assigned?",
        "Are you empty now or still getting offloaded?",
        "if not empty ask what is the city and state you are getting offloaded and what time was your apointment. if empty, ask what is your ETA to the shipper?",
        "Please confirm tractor, trailer and that you have the right equipment for this load.",
        "I've sent the Zuum tracking link—can you open it so tracking starts?",
        "Ask if they have already gotten a door or still waiting for a door number",
        "If they have door number then ask what it is?",
        "if driver does not give an eta then ask if they have reached the shipper?."
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Driver_empty": {
            "type": "boolean",
            "description": "Whether the driver is currently empty"
          },
          "ETA_to_shipper": {
            "type": "string",
            "description": "Estimated time of arrival to the shipper, stated by the driver.  If driver has reached, then 'reached'."
          },
          "off_loading_location": {
            "type": "string",
            "description": "The driver's off loading location."
          },
          "Confirmed_equipment": {
            "type": "boolean",
            "description": "Whether the driver confirmed they have the correct tractor, trailer, and required equipment"
          },
          "Is_assigned_driver": {
            "type": "boolean",
            "description": "Whether the person on the call is the driver assigned to the load"
          },
          "Tracking_started": {
            "type": "boolean",
            "description": "Whether the driver confirmed they opened the tracking link and tracking has started"
          },
          "door_number": {
            "type": "string",
            "description": "The door number provided by the trucker"
          }
        },
        "required": [
          "Driver_empty",
          "ETA_to_shipper",
          "off_loading_location",
          "Confirmed_equipment",
          "Is_assigned_driver",
          "Tracking_started",
          "door_number"
        ]
      }
    },
    "pickup_complete": {
      "title": "Pickup Complete",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "actual_pickup_time": {
          "label": "Actual pickup time stamp",
          "type": "datetime-local",
          "required": true
        },
        "bol_verified": {
          "label": "BOL / PO verified?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": true
        },
        "commodity_description": {
          "label": "Commodity description",
          "type": "text",
          "required": false
        },
        "next_stop_location": {
          "label": "Next stop city/state",
          "type": "text",
          "required": false
        },
        "scheduled_eta": {
          "label": "Scheduled ETA",
          "type": "datetime-local",
          "required": false
        },
        "accessorials_needed": {
          "label": "Accessorials needed so far? (lumper, temp check, straps)",
          "type": "text",
          "required": false
        }
      },
      "voice_questions": [
        "Have you been loaded and left the dock?",
        "If they have left the dock, then ask what time did they pull out?",
        "Does the PO or BOL on your paperwork match the rate-con?",
        "where are you heading next ? Will you go straight to the next stop or their yard for another driver to delivery the load ?",
        "if driver says either direction, then ask when do you expect to arrive"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Loaded_and_left_dock": {
            "type": "boolean",
            "description": "Whether the driver has been loaded and left the dock"
          },
          "ETA_to_next": {
            "type": "string",
            "description": "Estimated time of arrival to the next destination"
          },
          "Shipper_issues_reported": {
            "type": "boolean",
            "description": "Whether the driver reported any problems at the shipper"
          },
          "Departure_time": {
            "type": "string",
            "description": "Time the driver pulled out from the shipper, as stated by the driver"
          },
          "Next_destination": {
            "type": "string",
            "description": "Where the driver is headed next (typically delivery location or stop)"
          },
          "PO_BOL_matches_rate_con": {
            "type": "boolean",
            "description": "Whether the PO or BOL on the paperwork matches the rate confirmation"
          },
          "eta_to_destination": {
            "type": "string",
            "description": "Driver's eta to the destination."
          }
        },
        "required": [
          "Loaded_and_left_dock",
          "ETA_to_next",
          "Shipper_issues_reported",
          "Departure_time",
          "Next_destination",
          "PO_BOL_matches_rate_con",
          "eta_to_destination"
        ]
      }
    },
    "in_transit": {
      "title": "In Transit",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "current_location": {
          "label": "Current GPS city/state",
          "type": "text",
          "required": false
        },
        "remaining_miles": {
          "label": "Remaining miles",
          "type": "number",
          "required": false
        },
        "delay_reason": {
          "label": "Known delay reason",
          "type": "select",
          "options": [
            "None",
            "Weather",
            "Traffic",
            "HOS",
            "Breakdown"
          ],
          "required": false,
          "default": "None"
        }
      },
      "voice_questions": [
        "Tell the driver we are calling since we dont see them tracking or stopped tracking for some time and ask what city and state they are in.",
        "What's your updated ETA to the receiver?",
        "Do you foresee anything that could make you late—weather, HOS, equipment?",
        "Tell the driver to please turn on tracking so we don't have to keep calling for updates"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Risk_of_delay": {
            "type": "boolean",
            "description": "Whether the driver foresees any risk of delay (e.g., weather, HOS, equipment issues)"
          },
          "Delay_reason": {
            "type": "string",
            "description": "Optional details about potential delay if risk is present"
          },
          "Current_location_manual": {
            "type": "string",
            "description": "Driver's current location (city and state), manually confirmed if tracking is not available"
          },
          "Updated_ETA_to_receiver": {
            "type": "string",
            "description": "Driver's updated estimated time of arrival to the receiver"
          },
          "Tracking_restarted": {
            "type": "boolean",
            "description": "Whether the driver reopened the tracking app during the call"
          }
        },
        "required": [
          "Risk_of_delay",
          "Delay_reason",
          "Current_location_manual",
          "Updated_ETA_to_receiver",
          "Tracking_restarted"
        ]
      }
    },
    "at_drop": {
      "title": "At Drop (On site, unloading)",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "receiver_name": {
          "label": "Receiver name",
          "type": "text",
          "required": false
        },
        "receiver_address": {
          "label": "Receiver address",
          "type": "text",
          "required": false
        },
        "arrival_time": {
          "label": "Arrival time stamp",
          "type": "datetime-local",
          "required": true
        },
        "dock_number": {
          "label": "Dock #",
          "type": "text",
          "required": false
        },
        "lumper_needed": {
          "label": "Lumper needed?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "lumper_amount": {
          "label": "Lumper amount",
          "type": "number",
          "required": false
        },
        "payment_method": {
          "label": "Payment method",
          "type": "text",
          "required": false
        },
        "osd_observed": {
          "label": "OS&D observed so far?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        }
      },
      "voice_questions": [
        "Have you checked in and what dock number did they assign?",
        "Has unloading started, and how long did they quote you?",
        "Do you need a lumper code?",
        "If they need lumper code, then ask how much and what payment type do they accept?"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "Dock_number": {
            "type": "string",
            "description": "The dock number assigned to the driver"
          },
          "Unloading_duration_estimate": {
            "type": "string",
            "description": "Estimated time to complete unloading as quoted to the driver"
          },
          "Checked_in": {
            "type": "boolean",
            "description": "Whether the driver has checked in at the receiver"
          },
          "Unloading_started": {
            "type": "boolean",
            "description": "Whether unloading has started"
          }
        },
        "required": [
          "Dock_number",
          "Unloading_duration_estimate",
          "Checked_in",
          "Unloading_started"
        ]
      }
    },
    "delivered": {
      "title": "Delivered",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "empty_time": {
          "label": "Time empty / out-gate time",
          "type": "datetime-local",
          "required": true
        },
        "pod_uploaded": {
          "label": "POD uploaded?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "lumper_receipt": {
          "label": "Lumper receipt / scale ticket collected?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "final_osd": {
          "label": "Final OS&D?",
          "type": "select",
          "options": [
            "Y",
            "N"
          ],
          "required": false
        },
        "osd_notes": {
          "label": "OS&D notes",
          "type": "textarea",
          "required": false
        }
      },
      "voice_questions": [
        "What time were you released from the dock?",
        "Ask for any overages, shortages or damages noted by the warehouse ?",
        "have you uploaded the signed POD, sent it to your dispatcher or can you text a photo now",
        "Any lumper receipts or scale tickets we still need?",
        "Ask the turker if he needs any further assistence."
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "OSD_notes": {
            "type": "string",
            "description": "Driver's stated overages, shortages or damages noted by the warehouse. If no OSD, then 'None'."
          },
          "Dock_release_time": {
            "type": "string",
            "description": "The time the driver was released from the dock (e.g., '15:45' or '2025-06-06T15:45:00')"
          },
          "POD_uploaded": {
            "type": "boolean",
            "description": "Whether the signed POD has been uploaded to the Zuum app"
          },
          "POD_texted": {
            "type": "boolean",
            "description": "Whether the driver texted a photo of the signed POD (if not uploaded via app)"
          }
        },
        "required": [
          "OSD_notes",
          "Dock_release_time",
          "POD_uploaded"
        ]
      }
    },
    "request_pod": {
      "title": "Request POD - follow-up when POD still missing",
      "fields": {
        "load_id": {
          "label": "Load #",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Driver phone",
          "type": "tel",
          "required": true
        },
        "trucker_name": {
          "label": "Driver name",
          "type": "text",
          "required": true
        },
        "delivery_date": {
          "label": "Delivery date/time",
          "type": "datetime-local",
          "required": true
        },
        "upload_method": {
          "label": "Preferred upload method",
          "type": "select",
          "options": [
            "App",
            "MMS",
            "Email"
          ],
          "required": false
        },
        "reminder_attempt": {
          "label": "Reminder attempt #",
          "type": "select",
          "options": [
            "1",
            "2",
            "3"
          ],
          "required": false,
          "default": "1"
        }
      },
      "voice_questions": [
        "Ask the trucker have they uploaded the signed POD, sent it to your dispatcher or can you text a photo now since our records show we are still missing this."
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "POD_followup_received": {
            "type": "boolean",
            "description": "Whether the POD was successfully received during the follow-up call (via app upload or photo text)"
          }
        },
        "required": [
          "POD_followup_received"
        ]
      }
    },
    "default": {
      "title": "Default Load Information",
      "fields": {
        "load_id": {
          "label": "Load ID",
          "type": "text",
          "required": true
        },
        "carrier_name": {
          "label": "Carrier Name",
          "type": "text",
          "required": true
        },
        "purpose": {
          "label": "Purpose",
          "type": "text",
          "required": true
        },
        "contact_name": {
          "label": "Contact Name",
          "type": "text",
          "required": true
        },
        "contact_phone": {
          "label": "Contact Phone",
          "type": "tel",
          "required": true
        },
        "scheduled_pickup_time": {
          "label": "Scheduled Pickup Time",
          "type": "datetime-local",
          "required": true
        },
        "scheduled_delivery_time": {
          "label": "Scheduled Delivery Time",
          "type": "datetime-local",
          "required": true
        },
        "origin_address": {
          "label": "Origin Address",
          "type": "text",
          "required": true
        },
        "destination_address": {
          "label": "Destination Address",
          "type": "text",
          "required": true
        },
        "last_known_status": {
          "label": "Last Known Status",
          "type": "text",
          "required": true
        },
        "last_check_call_time": {
          "label": "Last Check Call Time",
          "type": "datetime-local",
          "required": false
        },
        "notes": {
          "label": "Notes",
          "type": "textarea",
          "required": false
        }
      },
      "voice_questions": [],
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  "FORM_TYPE_MAPPING": {
    "default": 0,
    "at_pickup": 1,
    "pickup_complete": 2,
    "in_transit": 3,
    "at_drop": 4,
    "delivered": 5,
    "request_pod": 6
  }
}